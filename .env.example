# Application
PORT=4000
NODE_ENV=development
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:4000,http://localhost:4001

# PostgreSQL Database (Docker)
DATABASE_URL="postgresql://boilerplate_user:boilerplate_password@localhost:5432/boilerplate_db?schema=public"

# Authentication / JWT
JWT_SECRET="replace_with_a_secure_random_key"
JWT_EXPIRES_IN="7d"

# File Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# Feature Flags (Set to false to disable a module for a client)
FEATURE_BLOG=true
FEATURE_WALLET=true
FEATURE_REFERRAL=true
FEATURE_COUPONS=true
FEATURE_ATTRIBUTES=true


