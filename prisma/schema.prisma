datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TransactionStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum WalletTransactionType {
  DEPOSIT
  ORDER_PAYMENT
  ORDER_PARTIAL_PAYMENT
  REFUND
  REFERRAL_REWARD
  CASHBACK
  ADMIN_ADJUSTMENT
}

enum RewardType {
  INHERIT
  FIXED
  PERCENTAGE
  DISABLED
}

enum ReferralStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ----------------------------------------------------
// Users & Authentication
// ----------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  nationalId   String?    @unique @db.VarChar(10)
  birthDate    DateTime?
  role         Role       @default(CUSTOMER)
  isActive     Boolean    @default(true)
  addresses     Address[]
  blogPosts     BlogPost[]
  orders        Order[]
  wallet        Wallet?
  referralCode  ReferralCode?
  referralsMade Referral[]     @relation("ReferrerUser")
  referral      Referral?      @relation("RefereeUser")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Address {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String   @default("Home") // e.g., Home, Office
  recipientName     String
  phone             String
  street            String
  city              String
  province          String
  postalCode        String
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("addresses")
}

// ----------------------------------------------------
// Product Categories (Hierarchical tree for furniture)
// ----------------------------------------------------

model Category {
  id           String     @id @default(uuid())
  name         String
  slug         String     @unique
  description  String?
  image        String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryHierarchy")
  displayOrder Int        @default(0)
  products     Product[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("categories")
}

// ----------------------------------------------------
// Products & WooCommerce-Style Variable Architecture
// ----------------------------------------------------

model Product {
  id               String             @id @default(uuid())
  name             String
  slug             String             @unique
  sku              String?            @unique
  productType      ProductType        @default(SIMPLE)
  description      String             @db.Text
  shortDescription String?            @db.Text
  basePrice        Decimal            @db.Decimal(10, 2)
  salePrice        Decimal?           @db.Decimal(10, 2)
  stockQuantity    Int                @default(0)
  manageStock      Boolean            @default(true)
  dimensions       String?            // e.g., "200x90x75 cm" (LxWxH)
  weight           Decimal?           @db.Decimal(10, 2) // weight in kg
  specifications   Json?              // Repeater key-value list: [{ label: string, value: string }]
  featured         Boolean            @default(false)
  status           ProductStatus      @default(PUBLISHED)
  categoryId       String?
  category         Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           ProductImage[]
  attributes          ProductAttribute[]
  variants            ProductVariant[]
  orderItems          OrderItem[]
  flashDealItems      FlashDealItem[]
  rewardType          RewardType         @default(INHERIT)
  referrerRewardValue Decimal?           @db.Decimal(10, 2)
  refereeRewardValue  Decimal?           @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url          String
  altText      String?
  displayOrder Int      @default(0)
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@map("product_images")
}

model Attribute {
  id                String             @id @default(uuid())
  name              String             // e.g. "Wood Finish", "Fabric Material", "Size"
  slug              String             @unique // e.g. "wood-finish", "fabric-material"
  displayType       String?            @default("TEXT") // "COLOR", "IMAGE", or "TEXT"
  values            AttributeValue[]
  productAttributes ProductAttribute[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("attributes")
}

model AttributeValue {
  id            String                  @id @default(uuid())
  attributeId   String
  attribute     Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  name          String                  // e.g. "Walnut", "Natural White Oak", "Emerald Velvet"
  value         String                  // e.g. "walnut", "natural-oak", "emerald-velvet"
  colorHex      String?                 // e.g. "#5C4033" for visual color swatches
  image         String?                 // e.g. image URL for fabrics, patterns, wood grains
  variantValues VariantAttributeValue[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([attributeId, value])
  @@map("attribute_values")
}

model ProductAttribute {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isVariation Boolean   @default(true) // true: used to generate variations; false: display specs only
  createdAt   DateTime  @default(now())

  @@unique([productId, attributeId])
  @@map("product_attributes")
}

model ProductVariant {
  id              String                  @id @default(uuid())
  productId       String
  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku             String                  @unique // e.g. "SW-SOFA-WAL-EMERALD"
  price           Decimal                 @db.Decimal(10, 2)
  salePrice       Decimal?                @db.Decimal(10, 2)
  stockQuantity   Int                     @default(0)
  image           String?
  weight          Decimal?                @db.Decimal(10, 2)
  dimensions      String?
  isActive        Boolean                 @default(true)
  attributeValues VariantAttributeValue[]
  orderItems      OrderItem[]
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("product_variants")
}

model VariantAttributeValue {
  id               String         @id @default(uuid())
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

// ----------------------------------------------------
// Blog Section (Furniture guides, trends, articles)
// ----------------------------------------------------

model BlogCategory {
  id           String         @id @default(uuid())
  name         String
  slug         String         @unique
  description  String?
  image        String?
  parentId     String?
  parent       BlogCategory?  @relation("BlogCategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     BlogCategory[] @relation("BlogCategoryHierarchy")
  displayOrder Int            @default(0)
  posts        BlogPost[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@map("blog_categories")
}

model BlogPost {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  content       String        @db.Text
  excerpt       String?       @db.Text
  featuredImage String?
  status        PostStatus    @default(PUBLISHED)
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  publishedAt   DateTime?     @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("blog_posts")
}

// ----------------------------------------------------
// Media & Asset Management
// ----------------------------------------------------

model Media {
  id           String   @id @default(uuid())
  filename     String   @unique
  originalName String
  mimeType     String
  size         Int      // File size in bytes
  url          String
  altText      String?
  caption      String?
  width        Int?
  height       Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("media")
}

// ----------------------------------------------------
// System & Store Settings (Key-Value configuration)
// ----------------------------------------------------

model SystemSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ----------------------------------------------------
// Promotional Coupons & Discounts
// ----------------------------------------------------

model Coupon {
  id                String       @id @default(uuid())
  code              String       @unique
  description       String?
  discountType      DiscountType @default(PERCENTAGE)
  discountValue     Decimal      @db.Decimal(10, 2)
  minOrderAmount    Decimal?     @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  startDate         DateTime?
  endDate           DateTime?
  usageLimit        Int?
  usageCount        Int          @default(0)
  isActive          Boolean      @default(true)
  orders            Order[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@map("coupons")
}

// ----------------------------------------------------
// Flash Deals & Special Offers (Time-limited Campaigns)
// ----------------------------------------------------

model FlashDeal {
  id              String          @id @default(uuid())
  title           String          // e.g. "تخفیف شگفت‌انگیز", "پیشنهادهای محدود امروز"
  slug            String          @unique
  description     String?         // e.g. "تا پایان زمان، فرصت خرید با پاداش بیشتر داری."
  badgeText       String?         // e.g. "فروش ویژه", "پیشنهاد شگفت‌انگیز"
  bannerImage     String?
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean         @default(true)
  defaultCashback       Decimal?        @db.Decimal(10, 2) // پاداش خرید پیش‌فرض برای آیتم‌ها (تومان)
  defaultReferrerReward Decimal?        @db.Decimal(10, 2) // پاداش معرف پیش‌فرض برای آیتم‌ها (تومان)
  items                 FlashDealItem[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@map("flash_deals")
}

model FlashDealItem {
  id             String       @id @default(uuid())
  dealId         String
  deal           FlashDeal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  discountType   DiscountType @default(PERCENTAGE)
  discountValue  Decimal      @db.Decimal(10, 2)
  specialPrice   Decimal      @db.Decimal(10, 2)
  cashbackAmount Decimal?     @db.Decimal(10, 2)
  referrerReward Decimal?     @db.Decimal(10, 2) // پاداش معرف (تومان)
  stockLimit     Int?
  soldCount      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([dealId, productId])
  @@map("flash_deal_items")
}

// ----------------------------------------------------
// Orders & Commerce
// ----------------------------------------------------

model Order {
  id              String          @id @default(uuid())
  orderNumber     String          @unique // e.g. "SW-1001"
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  customerEmail   String
  customerPhone   String?
  status          OrderStatus     @default(PENDING)
  paymentStatus   PaymentStatus   @default(PENDING)
  paymentMethod   String          @default("CREDIT_CARD") // CREDIT_CARD, BANK_TRANSFER, CASH_ON_DELIVERY, STRIPE
  transactionId   String?
  paidAt          DateTime?
  subtotal        Decimal         @db.Decimal(10, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  shippingAmount  Decimal         @default(0) @db.Decimal(10, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(10, 2)
  totalAmount      Decimal            @db.Decimal(10, 2)
  walletAmountPaid Decimal            @default(0) @db.Decimal(10, 2)
  cashAmountPaid   Decimal            @default(0) @db.Decimal(10, 2)
  currency         String             @default("USD")
  couponId         String?
  coupon           Coupon?            @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode       String?
  referralId       String?
  referral         Referral?          @relation(fields: [referralId], references: [id], onDelete: SetNull)
  shippingAddress Json            // { recipientName, phone, street, city, province, postalCode, country }
  billingAddress  Json?
  shippingMethod  String?            @default("Standard Freight")
  shippingCarrier String?            // e.g. "FedEx Freight", "Tipax", "Chapar", "Old Dominion"
  trackingNumber  String?
  trackingUrl     String?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  customerNotes   String?            @db.Text
  internalNotes   String?            @db.Text
  items           OrderItem[]
  timeline        OrderTimeline[]
  transactions    OrderTransaction[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("orders")
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productName        String
  productSku         String?
  variantName        String?
  productImage       String?
  unitPrice          Decimal         @db.Decimal(10, 2)
  quantity           Int             @default(1)
  totalPrice         Decimal         @db.Decimal(10, 2)
  cashbackEarned     Decimal?        @db.Decimal(10, 2)
  selectedAttributes Json?           // e.g. { "Wood Finish": "Walnut", "Fabric Material": "Emerald Velvet" }
  createdAt          DateTime        @default(now())

  @@map("order_items")
}

model OrderTimeline {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@map("order_timelines")
}

model OrderTransaction {
  id              String            @id @default(uuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gateway         String            // STRIPE, ZARINPAL, MELLAT, SAMAN_SEP, BANK_TRANSFER, CASH_ON_DELIVERY
  transactionId   String?           // Authority / Token / Charge ID
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(12, 2)
  currency        String            @default("USD") // USD, IRT (Toman), IRR (Rial)
  cardPan         String?           // Masked card number (e.g. 6037-99**-****-1234)
  trackingCode    String?           // Shaparak RRN / Reference number / SaleReferenceId
  errorMessage    String?
  gatewayResponse Json?             // Raw webhook / callback metadata
  createdAt       DateTime          @default(now())

  @@map("order_transactions")
}

// ----------------------------------------------------
// Shipping & Logistics Configuration
// ----------------------------------------------------

model ShippingMethod {
  id             String   @id @default(uuid())
  name           String
  type           String   @default("FIXED") // FIXED, FREE, LOCAL_PICKUP
  price          Decimal  @default(0) @db.Decimal(10, 2)
  currency       String   @default("USD")
  carrier        String?
  estimatedDays  String?
  description    String?  @db.Text
  minOrderAmount Decimal? @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("shipping_methods")
}

// ----------------------------------------------------
// OTP Phone Authentication & SMS Verification
// ----------------------------------------------------

model OtpVerification {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
  @@map("otp_verifications")
}

// ----------------------------------------------------
// Digital Wallet & Financial Ledger
// ----------------------------------------------------

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  currency     String              @default("IRT") // IRT (Toman), IRR (Rials)
  isActive     Boolean             @default(true)
  transactions WalletTransaction[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id            String                @id @default(uuid())
  walletId      String
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount        Decimal               @db.Decimal(12, 2) // Positive for credit (+), negative for debit (-)
  balanceBefore Decimal               @db.Decimal(12, 2)
  balanceAfter  Decimal               @db.Decimal(12, 2)
  type          WalletTransactionType
  description   String?
  referenceId   String?               // e.g. Order ID, Bank Tracking Code
  createdAt     DateTime              @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// ----------------------------------------------------
// Referral System & Affiliate Program
// ----------------------------------------------------

model ReferralCode {
  id                  String     @id @default(uuid())
  code                String     @unique // e.g. "REF-8291" or custom "MOHAMAD"
  ownerId             String     @unique
  owner               User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clickCount          Int        @default(0)
  successfulReferrals Int        @default(0)
  totalEarned         Decimal    @default(0) @db.Decimal(12, 2)
  isActive            Boolean    @default(true)
  referrals           Referral[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("referral_codes")
}

model Referral {
  id                   String         @id @default(uuid())
  referralCodeId       String
  referralCode         ReferralCode   @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referrerId           String
  referrer             User           @relation("ReferrerUser", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId            String         @unique
  referee              User           @relation("RefereeUser", fields: [refereeId], references: [id], onDelete: Cascade)
  status               ReferralStatus @default(PENDING)
  rewardAmountReferrer Decimal?       @db.Decimal(10, 2)
  rewardAmountReferee  Decimal?       @db.Decimal(10, 2)
  rewardedAt           DateTime?
  orders               Order[]
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@map("referrals")
}
